# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=task_management_db
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/task_management_db

# JWT Configuration (for future authentication milestones)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
